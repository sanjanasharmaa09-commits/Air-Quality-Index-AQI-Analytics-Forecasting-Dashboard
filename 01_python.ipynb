   "source": [
    "import requests\n",
    "import pandas as pd\n",
    "from datetime import datetime\n",
    " \n",
    "# -----------------------------\n",
    "# CONFIG\n",
    "# -----------------------------\n",
    "API_KEY = \"your_api_key_here\":\n" # <-- paste your OpenWeatherMap API key here\n",
    " \n",
    "CITIES = {\n",
    "    \"Delhi\":     (28.6139, 77.2090),\n",
    "    \"Mumbai\":    (19.0760, 72.8777),\n",
    "    \"Bangalore\": (12.9716, 77.5946),\n",
    "    \"Kolkata\":   (22.5726, 88.3639),\n",
    "    \"Bhopal\":    (23.2599, 77.4126),\n",
    "    \"Lucknow\":   (26.8467, 80.9462),\n",
    "    \"Chennai\":   (13.0827, 80.2707),\n",
    "    \"Ahmedabad\": (23.0225, 72.5714),\n",
    "    \"Patna\":     (25.5941, 85.1376),\n",
    "    \"Shillong\":  (25.5788, 91.8933),\n",
    "}\n",
    " \n",
    "OUTPUT_FILE = "live_aqi_data.csv"\n",
    " \n",
    " \n",
    "# -----------------------------\n",
    "# CPCB SUB-INDEX FORMULAS\n",
    "# Each pollutant has its own breakpoint table (CPCB official).\n",
    "# Formula: sub_index = ((AQI_hi - AQI_lo) / (BP_hi - BP_lo)) * (value - BP_lo) + AQI_lo\n",
    "# -----------------------------\n",
    " \n",
    "def linear_scale(value, bp_lo, bp_hi, aqi_lo, aqi_hi):\n",
    "    return ((aqi_hi - aqi_lo) / (bp_hi - bp_lo)) * (value - bp_lo) + aqi_lo\n",
    " \n",
    " \n",
    "def pm25_subindex(pm25):\n",
    "    if pm25 <= 30:   return linear_scale(pm25, 0, 30, 0, 50)\n",
    "    elif pm25 <= 60:  return linear_scale(pm25, 30, 60, 50, 100)\n",
    "    elif pm25 <= 90:  return linear_scale(pm25, 60, 90, 100, 200)\n",
    "    elif pm25 <= 120: return linear_scale(pm25, 90, 120, 200, 300)\n",
    "    elif pm25 <= 250: return linear_scale(pm25, 120, 250, 300, 400)\n",
    "    else:             return linear_scale(pm25, 250, 500, 400, 500)\n",
    " \n",
    " \n",
    "def pm10_subindex(pm10):\n",
    "    if pm10 <= 50:    return linear_scale(pm10, 0, 50, 0, 50)\n",
    "    elif pm10 <= 100:  return linear_scale(pm10, 50, 100, 50, 100)\n",
    "    elif pm10 <= 250:  return linear_scale(pm10, 100, 250, 100, 200)\n",
    "    elif pm10 <= 350:  return linear_scale(pm10, 250, 350, 200, 300)\n",
    "    elif pm10 <= 430:  return linear_scale(pm10, 350, 430, 300, 400)\n",
    "    else:              return linear_scale(pm10, 430, 700, 400, 500)\n",
    " \n",
    " \n",
    "def no2_subindex(no2):\n",
    "    if no2 <= 40:    return linear_scale(no2, 0, 40, 0, 50)\n",
    "    elif no2 <= 80:   return linear_scale(no2, 40, 80, 50, 100)\n",
    "    elif no2 <= 180:  return linear_scale(no2, 80, 180, 100, 200)\n",
    "    elif no2 <= 280:  return linear_scale(no2, 180, 280, 200, 300)\n",
    "    elif no2 <= 400:  return linear_scale(no2, 280, 400, 300, 400)\n",
    "    else:             return linear_scale(no2, 400, 600, 400, 500)\n",
    " \n",
    " \n",
    "def so2_subindex(so2):\n",
    "    if so2 <= 40:    return linear_scale(so2, 0, 40, 0, 50)\n",
    "    elif so2 <= 80:   return linear_scale(so2, 40, 80, 50, 100)\n",
    "    elif so2 <= 380:  return linear_scale(so2, 80, 380, 100, 200)\n",
    "    elif so2 <= 800:  return linear_scale(so2, 380, 800, 200, 300)\n",
    "    elif so2 <= 1600: return linear_scale(so2, 800, 1600, 300, 400)\n",
    "    else:             return linear_scale(so2, 1600, 2000, 400, 500)\n",
    " \n",
    " \n",
    "def co_subindex(co_mg_m3):\n",
    "    # API gives CO in ug/m3, CPCB breakpoints use mg/m3 -> convert first\n",
    "    if co_mg_m3 <= 1:    return linear_scale(co_mg_m3, 0, 1, 0, 50)\n",
    "    elif co_mg_m3 <= 2:   return linear_scale(co_mg_m3, 1, 2, 50, 100)\n",
    "    elif co_mg_m3 <= 10:  return linear_scale(co_mg_m3, 2, 10, 100, 200)\n",
    "    elif co_mg_m3 <= 17:  return linear_scale(co_mg_m3, 10, 17, 200, 300)\n",
    "    elif co_mg_m3 <= 34:  return linear_scale(co_mg_m3, 17, 34, 300, 400)\n",
    "    else:                 return linear_scale(co_mg_m3, 34, 50, 400, 500)\n",
    " \n",
    " \n",
    "def o3_subindex(o3):\n",
    "    if o3 <= 50:    return linear_scale(o3, 0, 50, 0, 50)\n",
    "    elif o3 <= 100:  return linear_scale(o3, 50, 100, 50, 100)\n",
    "    elif o3 <= 168:  return linear_scale(o3, 100, 168, 100, 200)\n",
    "    elif o3 <= 208:  return linear_scale(o3, 168, 208, 200, 300)\n",
    "    elif o3 <= 748:  return linear_scale(o3, 208, 748, 300, 400)\n",
    "    else:            return linear_scale(o3, 748, 1000, 400, 500)\n",
    " \n",
    " \n",
    "def get_aqi_bucket(aqi):\n",
    "    if aqi <= 50:   return \"Good\"\n",
    "    elif aqi <= 100: return \"Satisfactory\"\n",
    "    elif aqi <= 200: return \"Moderate\"\n",
    "    elif aqi <= 300: return \"Poor\"\n",
    "    elif aqi <= 400: return \"Very Poor\"\n",
    "    else:            return \"Severe\"\n",
    " \n",
    " \n",
    "def calculate_final_aqi(components):\n",
    "    \"\"\"CPCB rule: final AQI = MAX of all available sub-indices.\"\"\"\n",
    "    sub_indices = {\n",
    "        \"PM2_5\": pm25_subindex(components.get(\"pm2_5\", 0)),\n",
    "        \"PM10\":  pm10_subindex(components.get(\"pm10\", 0)),\n",
    "        \"NO2\":   no2_subindex(components.get(\"no2\", 0)),\n",
    "        \"SO2\":   so2_subindex(components.get(\"so2\", 0)),\n",
    "        \"CO\":    co_subindex(components.get(\"co\", 0) / 1000),  # ug/m3 -> mg/m3\n",
    "        \"O3\":    o3_subindex(components.get(\"o3\", 0)),\n",
    "    }\n",
    "    final_aqi = round(max(sub_indices.values()))\n",
    "    dominant_pollutant = max(sub_indices, key=sub_indices.get)\n",
    "    return final_aqi, dominant_pollutant, sub_indices\n",
    " \n",
    " \n",
    "# -----------------------------\n",
    "# API FETCH\n",
    "# -----------------------------\n",
    " \n",
    "def fetch_city_data(city, lat, lon, api_key):\n",
    "    url = \"http://api.openweathermap.org/data/2.5/air_pollution\"\n",
    "    params = {\"lat\": lat, \"lon\": lon, \"appid\": api_key}\n",
    " \n",
    "    response = requests.get(url, params=params, timeout=10)\n",
    "    response.raise_for_status()   # crashes loudly if API key/network fails\n",
    "    data = response.json()\n",
    " \n",
    "    components = data[\"list\"][0][\"components\"]\n",
    "    final_aqi, dominant_pollutant, sub_indices = calculate_final_aqi(components)\n",
    " \n",
    "    return {\n",
    "        \"City\": city,\n",
    "        \"Timestamp\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n",
    "        \"PM2_5\": components.get(\"pm2_5\"),\n",
    "        \"PM10\": components.get(\"pm10\"),\n",
    "        \"NO2\": components.get(\"no2\"),\n",
    "        \"SO2\": components.get(\"so2\"),\n",
    "        \"CO\": components.get(\"co\"),\n",
    "        \"O3\": components.get(\"o3\"),\n",
    "        \"AQI\": final_aqi,\n",
    "        \"AQI_Bucket\": get_aqi_bucket(final_aqi),\n",
    "        \"Dominant_Pollutant\": dominant_pollutant,\n",
    "    }\n",
    " \n",
    " \n",
    "def main():\n",
    "    if API_KEY == \"your_api_key_here\":\n",
    "        print(\"⚠️  Please paste your OpenWeatherMap API key in the API_KEY variable.\")\n",
    "        return\n",
    " \n",
    "    records = []\n",
    "    for city, (lat, lon) in CITIES.items():\n",
    "        try:\n",
    "            print(f\"Fetching data for {city}...\")\n",
    "            record = fetch_city_data(city, lat, lon, API_KEY)\n",
    "            records.append(record)\n",
    "        except Exception as e:\n",
    "            print(f\"  Failed for {city}: {e}\")\n",
    " \n",
    "    if not records:\n",
    "        print(\"No data fetched. Check API key / internet connection.\")\n",
    "        return\n",
    " \n",
    "    df = pd.DataFrame(records)\n",
    " \n",
    "    # Append to existing file if it exists, else create new\n",
    "    try:\n",
    "        existing = pd.read_csv(OUTPUT_FILE)\n",
    "        df = pd.concat([existing, df], ignore_index=True)\n",
    "    except FileNotFoundError:\n",
    "        pass\n",
    "\n",
    "    df.to_csv(OUTPUT_FILE, index=False)\n",
    "    print(f\"\\nSaved {len(records)} city records to {OUTPUT_FILE}\")\n",
    "    print(df[[\"City\", \"AQI\", \"AQI_Bucket\", \"Dominant_Pollutant\"]].to_string(index=False))\n",
    " \n",
    " \n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
  },
